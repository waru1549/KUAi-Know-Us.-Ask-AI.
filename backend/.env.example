# =========================================
# KUAi BACKEND ENVIRONMENT (template)
# Copy to backend/.env and fill in real values.
# Never commit backend/.env — it is git-ignored.
# In production, set these in Render → Environment instead.
# =========================================

# Port for local development (Render sets PORT automatically)
PORT=3000

# Google Gemini API key — https://aistudio.google.com/api-keys
GOOGLE_API_KEY=YOUR_GOOGLE_API_KEY

# Gemini model (this one is available on the free tier)
GEMINI_MODEL=gemini-3.5-flash-lite

# Website origins allowed to call the API (comma-separated, no trailing "/")
# Production example: https://team-portfolio-ai.vercel.app,https://team-portfolio-ai-git-main-waru1549.vercel.app
CORS_ORIGINS=http://localhost:5173

# PostgreSQL connection string.
# Local:    postgresql://postgres:postgres@localhost:5432/kuai
# Supabase: use the "Session pooler" URI and append ?sslmode=require&uselibpqcompat=true
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/kuai
